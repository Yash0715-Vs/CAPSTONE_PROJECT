# =====================================================================
# Environment Configuration Template (.env.example)
# Smart IT Asset & Support Ticket Management System
# Supports Profiles: DEV, QA, PROD (Capstone Section 33 & 34)
# =====================================================================

# --- Application Runtime Profile ---
# Options: dev | qa | prod
APP_ENV=dev
DEBUG=True
PORT=8000

# --- Database Configuration (MySQL 8.0 Primary Relational DB) ---
# DB_TYPE options: mysql (default production/dev) | postgres (tested in QA) | sqlite (local test)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=it_asset_db
DB_USER=root
# In production, DB_PASSWORD must be changed to a non-default strong password.
DB_PASSWORD=root

# Optional: Full SQLAlchemy URL (overrides individual DB_* fields above if set)
# Examples:
#   MySQL:      mysql+pymysql://root:password@localhost:3306/it_asset_db?charset=utf8mb4
#   PostgreSQL: postgresql://postgres:password@localhost:5432/it_asset_db
#   SQLite:     sqlite:///data/it_asset_local.db
# DATABASE_URL=sqlite:///data/it_asset_local.db

# --- Security & JWT Authentication ---
# In production (APP_ENV=prod), SECRET_KEY must be a strong 32+ character key
# (Generate via: openssl rand -hex 32). Default placeholder keys are blocked at startup.
SECRET_KEY=supersecretjwtkey_change_me_in_production_capstone_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Application Logging (Section 37) ---
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- External API Integration (Section 14) ---
WARRANTY_API_URL=https://api.example.com/assets/warranty
WARRANTY_API_TIMEOUT_SECONDS=5

# --- Frontend & CORS Settings ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
